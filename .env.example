# Backend del SITO DI PROVA. Questi valori sono solo server-side.
# Origine HTTPS di Atlas, senza slash finale o percorsi.
ECOMMERCE_ATLAS_ORIGIN=
ECOMMERCE_INTERNAL_AUDIENCE=

# Solo se Atlas usa Vercel Deployment Protection: segreto del progetto Atlas,
# passato in un header server-to-server. Non sostituisce la verifica OIDC.
ECOMMERCE_ATLAS_PROTECTION_BYPASS=

# Credenziale Mongo separata e limitata alle collezioni commerce_ ammesse.
# Nessun fallback a MONGODB_URI Atlas. Il DB commerce è separato dal DB gestionale,
# sullo stesso cluster usato dal processore interno.
ECOMMERCE_MONGODB_URI=
ECOMMERCE_MONGODB_DB=

# Identità del negozio: soltanto nel backend SITO, mai NEXT_PUBLIC_* o Atlas.
ECOMMERCE_SHOP_ID=
# Origine HTTPS esatta del sito di prova, senza slash finale; no wildcard/preview dinamiche.
ECOMMERCE_STOREFRONT_ORIGIN=
# In Atlas impostare ECOMMERCE_ASSERTION_ISSUER alla stessa origine.
# Dal passo 8 login/revoche mantengono metadati senza hash per le API personali.
# Atlas prepara collezioni e indici; il sito li verifica senza permessi DDL.
# Tracking: client OIDC con attestazione, nessuna nuova env o lettura diretta della vista.
# I privilegi sito escludono find su commerce_tracking_views dal passo 13.
# Nessuno script di migrazione o reset sessioni/carrelli per aggiungere campi.
# Chiave casuale dedicata: 32 byte codificati base64url (43 caratteri), distinta da NextAuth.
ECOMMERCE_AUTH_HMAC_KEY=
# Versioni pubbliche dei testi realmente presentati alla registrazione.
ECOMMERCE_AUTH_TERMS_VERSION=
ECOMMERCE_AUTH_PRIVACY_VERSION=
# Cifratura della coda email AES-256-GCM: ID attivo e mappa JSON ID -> chiave base64url 32 byte.
# Conservare le vecchie chiavi fino a svuotare/scadere le consegne; non usare chiavi HMAC/NextAuth.
ECOMMERCE_AUTH_EMAIL_KEY_ID=
ECOMMERCE_AUTH_EMAIL_KEYS=
# Provider email Resend separato dalle impostazioni Atlas; mittente semplice email già verificata.
ECOMMERCE_AUTH_RESEND_API_KEY=
ECOMMERCE_AUTH_MAIL_FROM=
# Bearer segreto casuale dedicato (43–128 caratteri base64url) per invocare il worker privato POST.
# Non è un segreto dell’API commerciale e non va nel browser.
ECOMMERCE_AUTH_DELIVERY_SECRET=

# Solo backend SITO: Bearer casuale dedicato 43–128 caratteri base64url per il worker
# privato di collegamento Clienti. Distinto dalle chiavi auth/email e da NextAuth.
ECOMMERCE_CUSTOMER_SYNC_SECRET=

# Percorsi pubblici interni dei testi effettivi approvati per il negozio.
# Non sono segreti. Nessun testo/consenso fittizio è previsto come fallback.
# Formato: /percorso, senza dominio, query o frammenti.
# Le versioni AUTH sopra devono corrispondere ai testi raggiungibili qui.
ECOMMERCE_AUTH_TERMS_PATH=
ECOMMERCE_AUTH_PRIVACY_PATH=
# Pubblica le condizioni di acquisto e usa la stessa versione della policy Atlas.
ECOMMERCE_CHECKOUT_TERMS_PATH=
ECOMMERCE_CHECKOUT_TERMS_VERSION=
